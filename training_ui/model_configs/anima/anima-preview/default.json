{
  "family": "anima",
  "name": "anima-preview",
  "sort_order": 0,
  "generation_type": "image",
  "source_script": "examples/anima/model_training/lora/anima-preview.sh",
  "train_script": "examples/anima/model_training/train.py",
  "defaults": {
    "model_paths": [
      {
        "model_id": "circlestone-labs/Anima",
        "file_pattern": "split_files/diffusion_models/anima-preview.safetensors",
        "local_path": "",
        "fp8": false
      },
      {
        "model_id": "circlestone-labs/Anima",
        "file_pattern": "split_files/text_encoders/qwen_3_06b_base.safetensors",
        "local_path": "",
        "fp8": false
      },
      {
        "model_id": "circlestone-labs/Anima",
        "file_pattern": "split_files/vae/qwen_image_vae.safetensors",
        "local_path": "",
        "fp8": false
      }
    ],
    "enable_custom_lora_target": false,
    "lora_target_modules": "",
    "lora_rank": 32,
    "dataset_repeat": 50,
    "resolution_mode": "max_pixels",
    "max_pixels": 1048576,
    "height": 1024,
    "width": 1024,
    "num_epochs": 5,
    "learning_rate": 1e-4,
    "optimizer": "torch.optim.AdamW",
    "gradient_accumulation": 1,
    "dataset_num_workers": 0,
    "find_unused_parameters": false,
    "extra_inputs": null
  },
  "training_args": {
    "tokenizer_path": "Qwen/Qwen3-0.6B:./",
    "tokenizer_t5xxl_path": "stabilityai/stable-diffusion-3.5-large:tokenizer_3/",
    "remove_prefix_in_ckpt": "pipe.dit.",
    "lora_base_model": "dit",
    "use_gradient_checkpointing": true,
    "data_file_keys": "image,video,audio,edit_image"
  },
  "stages": [
    {}
  ],
  "sampling": {
    "validate_script": "examples/anima/model_training/validate_lora/anima-preview.py",
    "output_extension": ".jpg",
    "sample_prompts": [
      "a dog"
    ]
  }
}
